// Jongwen — ระบบขอใช้สถานที่ / ขอใช้อุปกรณ์ / แจ้งซ่อม (อบต.น้ำชำ)
// โครงสร้างตารางอ้างอิงจาก packages/shared/src/types.ts และ ER Diagram ใน README.md
// ชื่อตาราง/คอลัมน์ในฐานข้อมูลเป็น snake_case (ผ่าน @map / @@map)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== Enums =====================

enum Role {
  USER
  STAFF
  APPROVER_L2
  APPROVER_L1
  ADMIN
}

enum VenueType {
  meeting
  pavilion
  field
  yard
  training
}

enum VenueStatus {
  available
  maintenance
}

enum EquipmentCategory {
  audio
  tent
  it
}

enum RequestType {
  booking
  borrow
  repair
}

enum RequestStatus {
  pending_staff
  pending_l2
  pending_l1
  approved
  rejected
  cancelled
  borrowing
  return_inspect
  returned
  repair_submitted
  repair_in_progress
  repair_awaiting_acceptance
  repair_done
}

enum SignLevel {
  staff
  l2
  l1
}

enum Decision {
  approve
  reject
}

enum PeriodKind {
  /// ช่วงเวลาที่ขอใช้จริง
  current
  /// ช่วงเวลาที่ขอเลื่อนไป (รออนุมัติการเลื่อน)
  reschedule
}

enum HandoverPhase {
  before
  after
}

enum ActivityKind {
  user
  role
  resource
  request
}

// ===================== Accounts =====================

model Account {
  id          String   @id
  username    String   @unique
  /// รหัสผ่านเข้ารหัสด้วย argon2id
  password    String
  name        String
  nickname    String
  initial     String
  role        Role
  position    String
  department  String
  phone       String
  lineName    String?  @map("line_name")
  lineUserId  String?  @map("line_user_id")
  /// { review, handover, walkIn, manageResources, sign, manageUsers }
  permissions Json
  /// ภาพลายเซ็น (data URL)
  signature   String?
  /// PIN 6 หลักเข้ารหัสด้วย argon2id สำหรับยืนยันการลงนาม
  pin         String?
  /// บัญชีสำหรับโหมดเดโม (เฉพาะโหมดเดโมเท่านั้นที่ล็อกอิน one-click ได้)
  isDemo      Boolean  @default(false) @map("is_demo")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  requests         Request[]         @relation("RequestRequester")
  walkInRequests   Request[]         @relation("RequestCreatedByStaff")
  signatureRecords SignatureRecord[]
  handoverRecords  HandoverRecord[]
  notifications    Notification[]
  sessions         Session[]
  activityLogs     ActivityLog[]

  @@index([role])
  @@index([isDemo])
  @@map("accounts")
}

// ===================== Resources =====================

model Venue {
  id             String      @id
  name           String
  type           VenueType
  building       String
  floor          String
  capacity       Int
  status         VenueStatus @default(available)
  enabled        Boolean     @default(true)
  facilities     String[]
  /// "HH:mm"
  openTime       String      @map("open_time")
  /// "HH:mm"
  closeTime      String      @map("close_time")
  /// 0 = อาทิตย์ … 6 = เสาร์
  openDays       Int[]       @map("open_days")
  advanceDays    Int         @map("advance_days")
  formName       String      @map("form_name")
  approvalLevels Int         @default(3) @map("approval_levels")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  requestVenues RequestVenue[]

  @@map("venues")
}

model Equipment {
  id        String            @id
  name      String
  category  EquipmentCategory
  stock     Int
  enabled   Boolean           @default(true)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  requestItems RequestItem[]

  @@map("equipments")
}

// ===================== Requests =====================

/// ตารางคำขอรวม 3 ประเภท (booking / borrow / repair) — คอลัมน์เฉพาะประเภทเป็น nullable
model Request {
  id     String        @id
  code   String        @unique
  type   RequestType
  status RequestStatus

  requesterId        String  @map("requester_id")
  requesterName      String  @map("requester_name")
  organization       String
  requesterSignature String? @map("requester_signature")

  // ----- แบบฟอร์มราชการ (แบบขอใช้สถานที่ / แบบคำขอใช้อุปกรณ์) -----
  writtenAt          String? @map("written_at")
  requesterPosition  String? @map("requester_position")
  addressHouseNo     String? @map("address_house_no")
  addressMoo         String? @map("address_moo")
  addressSubdistrict String? @map("address_subdistrict")
  addressDistrict    String? @map("address_district")
  addressProvince    String? @map("address_province")
  /// [{ item, forWhat }] ข้อ 1–3
  purposeItems       Json?   @map("purpose_items")

  // ----- booking / borrow -----
  purpose     String?
  activity    String?
  attendees   Int?
  attachments String[] @default([])

  // ----- borrow -----
  pickupDate        DateTime? @map("pickup_date") @db.Date
  returnDate        DateTime? @map("return_date") @db.Date
  returnRequestedAt DateTime? @map("return_requested_at") @db.Timestamptz(3)
  returnedAt        DateTime? @map("returned_at") @db.Timestamptz(3)

  // ----- repair -----
  repairBuilding        String?   @map("repair_building")
  repairFloor           String?   @map("repair_floor")
  repairLocation        String?   @map("repair_location")
  repairCategory        String?   @map("repair_category")
  repairDetail          String?   @map("repair_detail")
  repairPhotos          Int?      @map("repair_photos")
  repairResolution      String?   @map("repair_resolution")
  repairStaffSignature  String?   @map("repair_staff_signature")
  repairStaffSignerName String?   @map("repair_staff_signer_name")
  repairAcceptSignature String?   @map("repair_accept_signature")
  repairAcceptedAt      DateTime? @map("repair_accepted_at") @db.Timestamptz(3)
  repairStartedAt       DateTime? @map("repair_started_at") @db.Timestamptz(3)
  repairFinishedAt      DateTime? @map("repair_finished_at") @db.Timestamptz(3)
  repairAcceptedByReqAt DateTime? @map("repair_accepted_by_requester_at") @db.Timestamptz(3)

  // ----- Walk-in (เจ้าหน้าที่กรอกแทน) -----
  createdByStaffId        String? @map("created_by_staff_id")
  createdByStaffSignature String? @map("created_by_staff_signature")

  rejectReason String?  @map("reject_reason")
  approvalRound Int     @default(1) @map("approval_round")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  requester      Account  @relation("RequestRequester", fields: [requesterId], references: [id])
  createdByStaff Account? @relation("RequestCreatedByStaff", fields: [createdByStaffId], references: [id])

  venues     RequestVenue[]
  periods    RequestPeriod[]
  items      RequestItem[]
  signatures SignatureRecord[]
  handovers  HandoverRecord[]

  @@index([requesterId])
  @@index([type, status])
  @@index([createdAt])
  @@map("requests")
}

/// สถานที่ที่ขอใช้ในคำขอ (1 คำขอเลือกได้หลายสถานที่)
model RequestVenue {
  requestId String @map("request_id")
  venueId   String @map("venue_id")

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  venue   Venue   @relation(fields: [venueId], references: [id])

  @@id([requestId, venueId])
  @@index([venueId])
  @@map("request_venues")
}

/// ช่วงวัน-เวลาที่ขอใช้ (ใช้กับทุกสถานที่ในคำขอ) และช่วงที่ขอเลื่อน
model RequestPeriod {
  id        Int        @id @default(autoincrement())
  requestId String     @map("request_id")
  kind      PeriodKind @default(current)
  sortOrder Int        @default(0) @map("sort_order")
  startTime DateTime   @map("start_time") @db.Timestamptz(3)
  endTime   DateTime   @map("end_time") @db.Timestamptz(3)

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([startTime, endTime])
  @@map("request_periods")
}

/// อุปกรณ์ในคำขอ (borrow = รายการขอใช้อุปกรณ์, booking = อุปกรณ์เสริม)
model RequestItem {
  id          Int    @id @default(autoincrement())
  requestId   String @map("request_id")
  equipmentId String @map("equipment_id")
  qty         Int

  request   Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id])

  @@index([requestId])
  @@index([equipmentId])
  @@map("request_items")
}

/// ลายมือชื่อผู้ตรวจ/ผู้อนุมัติ 3 ระดับ (staff → l2 ปลัด → l1 นายก)
model SignatureRecord {
  id         Int       @id @default(autoincrement())
  requestId  String    @map("request_id")
  level      SignLevel
  round      Int       @default(1)
  signerId   String    @map("signer_id")
  signerName String    @map("signer_name")
  title      String
  decision   Decision
  signature  String?
  note       String?
  signedAt   DateTime  @default(now()) @map("signed_at") @db.Timestamptz(3)

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  signer  Account @relation(fields: [signerId], references: [id])

  @@unique([requestId, level, round])
  @@index([signerId])
  @@map("signature_records")
}

/// เช็คลิสต์รับมอบ (before) / รับคืน (after)
model HandoverRecord {
  id               Int           @id @default(autoincrement())
  requestId        String        @map("request_id")
  phase            HandoverPhase
  /// [{ label, ok }]
  checklist        Json
  note             String        @default("")
  staffId          String        @map("staff_id")
  staffName        String?       @map("staff_name")
  citizenSignature String?       @map("citizen_signature")
  staffSignature   String?       @map("staff_signature")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  staff   Account @relation(fields: [staffId], references: [id])

  @@unique([requestId, phase])
  @@map("handover_records")
}

// ===================== Others =====================

model Notification {
  id        String   @id
  userId    String   @map("user_id")
  title     String
  body      String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user Account @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

model ActivityLog {
  id        String       @id
  kind      ActivityKind
  title     String
  detail    String
  actorId   String?      @map("actor_id")
  actorName String?      @map("actor_name")
  actorRole Role?        @map("actor_role")
  ip        String?      @map("ip")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  actor Account? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
  @@map("activity_logs")
}

model Session {
  token     String   @id
  accountId String   @map("account_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
  @@map("sessions")
}

model Sequence {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("sequences")
}

model OtpCode {
  id         String    @id @default(cuid())
  phone      String    @map("phone")
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0) @map("attempts")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phone])
  @@map("otp_codes")
}
