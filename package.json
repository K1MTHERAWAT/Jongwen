{
  "name": "jongwen-booking",
  "private": true,
  "version": "0.1.0",
  "description": "Jongwen · ระบบจองสถานที่ ยืม–คืนครุภัณฑ์ และแจ้งซ่อม (monorepo: Next.js + NestJS + Tailwind)",
  "scripts": {
    "build:shared": "pnpm --filter @jongwen/shared build",
    "dev": "pnpm build:shared && pnpm --parallel --filter @jongwen/api --filter @jongwen/web dev",
    "dev:web": "pnpm --filter @jongwen/web dev",
    "dev:api": "pnpm --filter @jongwen/api dev",
    "build": "pnpm build:shared && pnpm --filter @jongwen/api build && pnpm --filter @jongwen/web build",
    "start": "pnpm --parallel --filter @jongwen/api --filter @jongwen/web start",
    "test": "vitest run",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:psql": "docker exec -it jongwen-postgres psql -U jongwen -d jongwen",
    "db:seed": "pnpm --filter @jongwen/api prisma:seed",
    "db:clear": "pnpm --filter @jongwen/api exec tsx prisma/clear.ts",
    "db:studio": "pnpm --filter @jongwen/api prisma:studio"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "vitest": "^5.0.5"
  }
}